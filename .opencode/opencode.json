{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": {
      "*": "ask",
      "uv --version": "allow",
      "uv sync": "allow",
      "uv sync *": "allow",
      "uv run inv": "allow",
      "uv run inv --list": "allow",
      "uv run inv tools.*": "allow",
      "uv run ruff check": "allow",
      "uv run ruff check *": "allow",
      "uv run ruff format": "allow",
      "uv run ruff format --check": "allow",
      "uv run ruff format --check *": "allow",
      "uv run pytest": "allow",
      "uv run pytest *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git switch *": "allow",
      "git checkout -b *": "allow",
      "git add *": "allow",
      "git commit": "allow",
      "git commit *": "allow",
      "git commit --amend*": "ask",
      "git stash": "allow",
      "git stash list": "allow",
      "git fetch *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push * --force*": "deny",
      "git push * -f*": "deny",
      "git reset --hard*": "deny",
      "git checkout -- *": "deny",
      "git clean *": "deny",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "sudo *": "deny"
    }
  }
}
